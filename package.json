{
  "name": "life-mentor-registration",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:local": "wrangler d1 execute mentor-demo --config wrangler.local.jsonc --local --file=work/seed-demo.sql",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "preview": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "test": "npm run test:security && npm run test:upgrade && npm run test:attendance && node scripts/test-local.mjs && node scripts/test-local.mjs --formal",
    "test:api": "node scripts/test-api-v2.mjs && node scripts/test-edge-v2.mjs",
    "test:ui": "node scripts/test-ui-v2.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:attendance": "node scripts/test-attendance-review.mjs",
    "test:upgrade": "node scripts/test-upgrade.mjs",
    "test:security": "node tests/security.mjs && node tests/hardening.mjs && node tests/security-review.mjs && node tests/network.mjs && node tests/identity.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "4.149.0",
    "undici": "^7.29.0"
  },
  "description": "Self-hostable training registration with per-session capacity, deadlines and a staff console.",
  "license": "MIT",
  "author": "Chengyang Lu (Lurek Lu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lurek-st/life-mentor-registration.git"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
