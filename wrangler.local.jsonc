{
  "name": "life-mentor-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_MODE": "preview",
    "DATA_SPACE": "local-demo",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mentor-demo",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "observability": {
    "enabled": false,
  },
}
